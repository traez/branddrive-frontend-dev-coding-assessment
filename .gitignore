# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# db dumps at repo root (contain password hashes + sessions — never commit)
# NOTE: root-scoped only so tracked supabase/migrations/*.sql still commits
*.dump
/*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode/tasks.json